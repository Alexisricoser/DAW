<odoo>

    <record id="action_crear_reparto_wizard" model="ir.actions.act_window">
        <field name="name">Crear Reparto Rápido</field>
        <field name="res_model">repartidor.crear.reparto.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_wizard_reparto" name="Nuevo Reparto Rápido" parent="menu_base" action="action_crear_reparto_wizard" sequence="20"/>

    <record id="view_crear_reparto_wizard_form" model="ir.ui.view">
        <field name="name">repartidor.crear.reparto.wizard.form</field>
        <field name="model">repartidor.crear.reparto.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="codigo"/>
                        <field name="repartidor_id"/>
                        <field name="vehiculo_id"/>
                        <field name="urgencia"/>
                        <field name="cliente_emisor_id"/>
                        <field name="receptor_nombre"/>
                    </group>
                    <group>
                        <field name="fecha_recepcion"/>
                        <field name="fecha_inicio"/>
                        <field name="fecha_retorno"/>
                        <field name="kilometros" string="Kilómetros Previstos"/>
                        <field name="volumen" string="Volumen Previstos"/>
                        <field name="peso" string="Peso (kg) Previstos"/>
                        <field name="observaciones"/>
                    </group>
                    <footer>
                        <button name="action_crear" string="Crear Reparto" type="object" class="btn-primary"/>
                        <button string="Cancelar" class="btn-secondary" special="cancel"/>
                    </footer>
                </group>
            </form>
        </field>
    </record>
</odoo>